# 复制为 .dev.vars 供 `wrangler pages dev` 本地使用（该文件已被 .gitignore 忽略）
OWNER_SECRET=换成一串足够长的随机字符串
# --- 管理后台 ---
ADMIN_SETUP_TOKEN=首次创建管理员用的一次性口令
GITHUB_TOKEN=github_pat_xxxx
GITHUB_REPO=yourname/yourrepo
# CF_API_TOKEN=   # 可选：显示构建状态
# DEPLOY_HOOK_URL=   # 可选：手动触发重建
OWNER_NAME=new
SITE_NAME=new way
# --- 邮件（Resend）---
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=new way <noreply@xxxx.org>
NOTIFY_EMAIL=you@example.com
# --- 机器人（按需，至少配一个就行）---
TG_BOT_TOKEN=
TG_CHAT_ID=
SERVERCHAN_KEY=
WEBHOOK_URL=
WEBHOOK_TYPE=wecom
