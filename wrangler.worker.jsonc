{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neway",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*"]
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "blog-db", "database_id": "ee01e62b-8d08-4843-a3d5-733538f4de5f" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "blog-media" }
  ],

  "vars": {
    "SITE_NAME": "new way",
    "OWNER_NAME": "newey",
    "MEDIA_BASE": "https://cdn.neway.site",
    "GITHUB_REPO": "aufsc/neway",
    "GITHUB_BRANCH": "main"
  },

  "observability": { "enabled": true }
}
